<!--
  CODEMAP FILE: src/SiteCheck.Desktop/MainWindow.axaml
  Product: Rampart (oli-site-check) — read-only public-surface hostname checker, public pin 1.9.0
  Role: Avalonia layout mirroring WPF: consent, findings, how-to, save.
  Called by: App.axaml.cs.
  Calls: MainWindow.axaml.cs.
  Invariants: Same two consent boxes. FindingGuide for how-to. DPAPI protect is a no-op off Windows.
  Sisters: Bastion (bastion-hardening) hardens the local Windows PC. bastion-web is the public storefront and hosts /rampart plus the GitHub asset redirect. oli-web-kits client brochures should already 404 the probe paths this checker GETs.
  Map: docs/CODEMAP.md — read that file first for the run/load graph.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SiteCheck.Desktop"
        x:Class="SiteCheck.Desktop.MainWindow"
        Title="Rampart  ·  Operation Locked In"
        Width="1280" Height="860"
        MinWidth="880" MinHeight="600"
        WindowState="Maximized"
        Background="#070B14">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0C1220" Padding="40,20,40,12">
      <StackPanel HorizontalAlignment="Center">
        <Image Source="avares://SiteCheck.Desktop/Assets/sitecheck.png" Width="64" Height="64" HorizontalAlignment="Center"/>
        <TextBlock Text="OPERATION LOCKED IN" Foreground="#5EEAD4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock Text="Rampart" FontSize="34" FontWeight="SemiBold" FontFamily="Georgia" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        <Border Height="3" Width="88" Background="#2DD4BF" HorizontalAlignment="Center" Margin="0,12,0,0"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#0C1220" Padding="32,14" BorderBrush="#243247" BorderThickness="0,1,0,0">
      <StackPanel>
        <TextBlock Foreground="#C5D0DE" FontSize="12" TextWrapping="Wrap"
                   Text="Copyright 2026 Jesse Mosier-Bowers, operating as Operation Locked In, Courtice, Ontario. Rampart is free software under the GNU General Public License version 3. There is no warranty, to the extent permitted by law."/>
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
          <Button Content="Lawful use" Click="Lawful_Click" Classes="ghost"/>
          <Button Content="Licence and warranty" Click="Licence_Click" Classes="ghost"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="24,20">
        <TextBlock TextWrapping="Wrap" Foreground="#C5D0DE" FontSize="15" LineHeight="24"
                   Text="A read-only public-surface assessment of a hostname you operate, or for which you have written permission. After both permission boxes are ticked, the program resolves public Internet addresses, reads TLS, requests a small set of public HTTPS paths (including common sign-in, admin, and private-file paths), checks the www and apex pair, and asks DNS for mail records. Findings that need work include a How to fix this panel with copyable lines. Operation Locked In does not authorize use against a hostname without that permission."/>

        <Border Background="#162033" CornerRadius="18" Padding="24" Margin="0,22,0,0" BorderBrush="#243247" BorderThickness="1">
          <StackPanel Spacing="8">
            <TextBlock Text="Hostname" FontWeight="SemiBold"/>
            <TextBox Name="HostBox" Watermark="www.example.com" MaxLength="253"/>
            <TextBlock Foreground="#C5D0DE" FontSize="13" TextWrapping="Wrap"
                       Text="Type a public hostname. You may paste a full https address; only the hostname is kept."/>
            <TextBlock Text="Scope" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <RadioButton Name="StandardScope" GroupName="Scope" IsChecked="True" Content="Standard public-surface check. HTTPS, certificate, TLS, headers, cookies, homepage markup, public edge, mail DNS, sign-in and admin paths, private-file paths, www and apex, and the local CVE catalogue."/>
            <RadioButton Name="AssessmentScope" GroupName="Scope" Content="Authorized public-surface assessment. Adds RFC public files, the MTA-STS policy host, extra DNS, and Cloudflare homepage extras. Still read-only."/>
            <CheckBox Name="PermissionBox" Content="I operate this hostname, or I have written permission from the person who operates it, to run this program against it."/>
            <CheckBox Name="LawBox" Content="I will not use this program against any hostname I do not operate and for which I do not have written permission. Operation Locked In does not authorize that use. Unauthorized use can be an offence in Canada under Criminal Code section 342.1. This screen is not legal advice."/>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
              <Button Name="RunButton" Classes="primary" Content="Check this hostname" Click="Run_Click" IsEnabled="False"/>
              <Button Name="CancelButton" Classes="ghost" Content="Stop this check" Click="Cancel_Click" IsVisible="False"/>
              <Button Name="CopyButton" Classes="ghost" Content="Copy report" Click="Copy_Click" IsEnabled="False"/>
              <Button Name="SaveButton" Classes="ghost" Content="Save report" Click="Save_Click" IsEnabled="False"/>
            </StackPanel>
            <CheckBox Name="ProtectFileBox" Margin="0,10,0,0"
                      Content="Protect a saved file for this Windows user only. Other accounts cannot read it. Linux and macOS testing copies save ordinary text."/>
            <TextBlock Name="StatusText" Foreground="#C5D0DE" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="No check has been run yet. Enter a public hostname, tick both permission boxes, then choose Check this hostname."/>
          </StackPanel>
        </Border>

        <Border Name="SummaryBox" IsVisible="False" Background="#162033" CornerRadius="18" Padding="24" Margin="0,18,0,0" BorderBrush="#243247" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="THIS RUN" Foreground="#5EEAD4" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Name="SummaryTitle" FontFamily="Georgia" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Name="SummaryScope" Foreground="#5EEAD4" FontSize="13" Margin="0,6,0,0"/>
            <TextBlock Name="SummaryBody" Foreground="#C5D0DE" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <ItemsControl Name="SectionList" Margin="0,16,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="22" FontWeight="SemiBold" Margin="4,16,4,8"/>
                <ItemsControl ItemsSource="{Binding Cards}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <local:ResponsiveCardPanel MinColumnWidth="560" MaxColumns="3"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#162033" CornerRadius="16" Margin="8" BorderBrush="#243247" BorderThickness="1" Padding="18">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock Text="{Binding State}" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="12" Foreground="{Binding StateBrush}"/>
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" FontFamily="Georgia" TextWrapping="Wrap"/>
                          </DockPanel>
                          <TextBlock Text="{Binding Observation}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                          <Expander Header="Details" Margin="0,10,0,0">
                            <StackPanel Margin="0,8,0,0">
                              <TextBlock Text="How this was gathered" Foreground="#5EEAD4" FontSize="12" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Method}" Foreground="#C5D0DE" TextWrapping="Wrap" Margin="0,4,0,8"/>
                              <TextBlock Text="What this does not mean" Foreground="#5EEAD4" FontSize="12" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Caveat}" Foreground="#C5D0DE" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                          </Expander>
                          <Expander Header="When to do this / when to skip" IsVisible="{Binding HasWhen}" IsExpanded="True" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                              <TextBlock Text="{Binding WhenTo}" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding WhenNot}" Foreground="#C5D0DE" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                          </Expander>
                          <Expander Header="How to fix this" IsVisible="{Binding HasFix}" IsExpanded="True" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                              <TextBlock Text="{Binding FixTitle}" FontFamily="Georgia" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding FixBody}" Foreground="#C5D0DE" TextWrapping="Wrap" Margin="0,8,0,10"/>
                              <ItemsControl ItemsSource="{Binding FixLines}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Background="#0C1220" CornerRadius="12" Padding="12" Margin="0,0,0,8" BorderBrush="#243247" BorderThickness="1">
                                      <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="ghost" Content="Copy" Margin="8,0,0,0" VerticalAlignment="Top"
                                                Tag="{Binding Copy}" Click="CopyLine_Click" IsVisible="{Binding HasCopy}"/>
                                        <StackPanel>
                                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                          <TextBlock Text="{Binding Copy}" FontFamily="Consolas, Menlo, monospace" Foreground="#5EEAD4" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding HasCopy}"/>
                                        </StackPanel>
                                      </DockPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Expander>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
