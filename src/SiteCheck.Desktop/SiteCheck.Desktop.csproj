<!--
  CODEMAP FILE: src/SiteCheck.Desktop/SiteCheck.Desktop.csproj
  Product: Rampart (oli-site-check) — read-only public-surface hostname checker, public pin 1.9.0
  Role: Avalonia desktop csproj. Publishes linux-x64, osx-x64, osx-arm64 zips via tools/publish.ps1.
  Called by: publish.ps1.
  Calls: SiteCheck.Core.
  Invariants: These zips are testing copies. Do not advertise them as store listings.
  Sisters: Bastion (bastion-hardening) hardens the local Windows PC. bastion-web is the public storefront and hosts /rampart plus the GitHub asset redirect. oli-web-kits client brochures should already 404 the probe paths this checker GETs.
  Map: docs/CODEMAP.md — read that file first for the run/load graph.
-->

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.9.0</Version>
    <InformationalVersion>1.9.0</InformationalVersion>
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
    <FileVersion>1.9.0.0</FileVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Product>Rampart</Product>
    <Authors>Jesse Mosier-Bowers</Authors>
    <Company>Operation Locked In</Company>
    <Copyright>Copyright 2026 Jesse Mosier-Bowers, operating as Operation Locked In</Copyright>
    <Description>Rampart desktop for Windows, macOS, and Linux (Avalonia).</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>..\SiteCheck.App\Assets\sitecheck.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SiteCheck.Core\SiteCheck.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
    <EmbeddedResource Include="..\..\docs\lawful-use.md" LogicalName="LAWFUL-USE.md" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
