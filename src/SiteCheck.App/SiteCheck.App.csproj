<!--
  CODEMAP FILE: src/SiteCheck.App/SiteCheck.App.csproj
  Product: Rampart (oli-site-check) — read-only public-surface hostname checker, public pin 1.9.0
  Role: WinExe net8.0-windows WPF. Version properties pinned 1.9.0. Embeds LICENSE and lawful-use.md. ApplicationManifest + icon.
  Called by: tools/publish.ps1 -o dist/Rampart.exe.
  Calls: ProjectReference SiteCheck.Core.
  Invariants: Do not bump Version unless a numbered release is intended. Catalogue rebuilds replace the v1.9.0 asset in place.
  Sisters: Bastion (bastion-hardening) hardens the local Windows PC. bastion-web is the public storefront and hosts /rampart plus the GitHub asset redirect. oli-web-kits client brochures should already 404 the probe paths this checker GETs.
  Map: docs/CODEMAP.md — read that file first for the run/load graph.
-->

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.9.0</Version>
    <InformationalVersion>1.9.0</InformationalVersion>
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
    <FileVersion>1.9.0.0</FileVersion>
    <Authors>Jesse Mosier-Bowers</Authors>
    <Company>Operation Locked In</Company>
    <Product>Rampart</Product>
    <Description>Read-only public-surface assessment of a hostname you operate.</Description>
    <AssemblyTitle>Rampart</AssemblyTitle>
    <Copyright>Copyright 2026 Jesse Mosier-Bowers, operating as Operation Locked In</Copyright>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\sitecheck.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiteCheck.Core\SiteCheck.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
    <EmbeddedResource Include="..\..\docs\lawful-use.md" LogicalName="LAWFUL-USE.md" />
    <Resource Include="Assets\sitecheck.png" />
  </ItemGroup>

</Project>
