<Window x:Class="SiteCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rampart  ·  Operation Locked In"
        Height="920" Width="1020" MinHeight="720" MinWidth="860"
        Background="{StaticResource NavyBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="Assets/sitecheck.png"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Navy900Brush}" Padding="48,22,48,0">
            <StackPanel MaxWidth="880" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Kicker}" Text="OPERATION LOCKED IN" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                <TextBlock Style="{StaticResource Title}" Text="Rampart" Margin="0,8,0,0" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                <Border Height="3" Background="{StaticResource TealBrush}" Width="88" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Navy900Brush}" Padding="48,18,48,22" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel MaxWidth="880" HorizontalAlignment="Center">
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="20"
                           Text="Copyright 2026 Jesse Mosier-Bowers, operating as Operation Locked In, Courtice, Ontario. Rampart is free software under the GNU General Public License version 3. There is no warranty, to the extent permitted by law."/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource LinkButton}" Content="Lawful use" Click="Lawful_Click"/>
                    <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource LinkButton}" Content="Licence and warranty" Click="Licence_Click"/>
                    <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource LinkButton}" Content="Info@operationlockedin.com" Click="Email_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource NavyBrush}">
            <StackPanel Margin="48,28,48,36" MaxWidth="880" HorizontalAlignment="Center">
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="16" LineHeight="26"
                           Text="A read-only public-surface assessment of a hostname you operate, or for which you have written permission. After both permission boxes are ticked, the program resolves public Internet addresses, reads TLS, requests a small set of public HTTPS paths, and asks DNS for mail records. Findings that need work include a How to fix this panel with full sentences and copyable lines for this hostname only. Operation Locked In does not authorize use against a hostname without that permission."/>

                <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="28" Margin="0,28,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Hostname" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBox x:Name="HostBox" Style="{StaticResource HostBox}"/>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,8,0,0"
                                   Text="Type a public hostname. You may paste a full https address; only the hostname is kept. Example: www.example.com"/>
                        <TextBlock Text="Scope" FontWeight="SemiBold" FontSize="13" Margin="0,18,0,10"/>
                        <RadioButton x:Name="StandardScope" GroupName="Scope" IsChecked="True" Checked="Scope_Changed">
                            <TextBlock TextWrapping="Wrap" LineHeight="22">Standard public-surface check. HTTPS, certificate, TLS, headers, cookies, homepage markup, public edge (Cloudflare and similar), SPF, DMARC, MX, nameservers, and the local CVE catalogue.</TextBlock>
                        </RadioButton>
                        <RadioButton x:Name="AssessmentScope" GroupName="Scope" Checked="Scope_Changed">
                            <TextBlock TextWrapping="Wrap" LineHeight="22">Authorized public-surface assessment. Adds RFC public files, the MTA-STS policy host, extra DNS (CAA, DKIM, DNSSEC, MTA-STS, BIMI, TLS-RPT), and Cloudflare dashboard settings visible on the homepage. Still read-only. Still no exploit traffic.</TextBlock>
                        </RadioButton>
                        <CheckBox x:Name="PermissionBox" Margin="0,8,0,0" Checked="Consent_Changed" Unchecked="Consent_Changed">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" LineHeight="22" FontSize="14">
                                I operate this hostname, or I have written permission from the person who operates it, to run this program against it.
                            </TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="LawBox" Margin="0,12,0,0" Checked="Consent_Changed" Unchecked="Consent_Changed">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" LineHeight="22" FontSize="14">
                                I will not use this program against any hostname I do not operate and for which I do not have written permission. Operation Locked In does not authorize, condone, or accept that use. I understand that using a computer system fraudulently and without colour of right can be a criminal offence in Canada under Criminal Code section 342.1, and that similar laws apply in other countries. This screen is not legal advice.
                            </TextBlock>
                        </CheckBox>
                        <WrapPanel Margin="0,20,0,0">
                            <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Content="Check this hostname" Click="Run_Click" IsEnabled="False"/>
                            <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="Stop this check" Margin="12,0,0,0" Click="Cancel_Click" Visibility="Collapsed"/>
                            <Button x:Name="CopyButton" Style="{StaticResource GhostButton}" Content="Copy report" Margin="12,0,0,0" Click="Copy_Click" IsEnabled="False"/>
                            <Button x:Name="SaveButton" Style="{StaticResource GhostButton}" Content="Save report" Margin="12,0,0,0" Click="Save_Click" IsEnabled="False"/>
                        </WrapPanel>
                        <ProgressBar x:Name="BusyBar" Height="3" Margin="0,18,0,0" IsIndeterminate="True" Visibility="Collapsed"
                                     Foreground="{StaticResource TealBrush}" Background="#070B14" BorderThickness="0"/>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" LineHeight="22" FontSize="14"
                                   Text="No check has been run yet. Enter a public hostname, tick both permission boxes, then choose Check this hostname or press Enter."/>
                    </StackPanel>
                </Border>

                <Border x:Name="SummaryBox" Visibility="Collapsed" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="28" Margin="0,22,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" Text="THIS RUN"/>
                        <TextBlock x:Name="SummaryTitle" FontFamily="Georgia" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="SummaryScope" Foreground="{StaticResource TealSoftBrush}" FontSize="13" Margin="0,6,0,0"/>
                        <TextBlock x:Name="SummaryBody" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" LineHeight="22"/>
                        <ItemsControl x:Name="StackList" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0C1220" BorderBrush="#2DD4BF" BorderThickness="1" CornerRadius="14" Padding="12,6" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TealSoftBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="NextBox" Visibility="Collapsed" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="28" Margin="0,22,0,0" BorderBrush="{StaticResource TealBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" Text="WHAT TO DO NEXT"/>
                        <TextBlock Text="Only steps that apply to this hostname and this run." FontFamily="Georgia" FontSize="20" Margin="0,8,0,14"/>
                        <ItemsControl x:Name="NextList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,18" LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="{StaticResource TealBrush}" Margin="0,8,14,0" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Environment}" Foreground="{StaticResource TealSoftBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" FontFamily="Georgia" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Body}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" LineHeight="22"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="FindingsList" Margin="0,22,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                            <TextBlock Text="{Binding Section}" FontFamily="Georgia" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Section}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="18" Margin="0,0,0,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <DockPanel>
                                    <Border Width="5" Background="{Binding AccentBrush}" CornerRadius="18,0,0,18"/>
                                    <StackPanel Margin="22,20,22,20">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="{Binding State}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="{Binding StateBrush}" Margin="12,4,0,0"/>
                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" FontFamily="Georgia"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Observation}" Margin="0,10,0,0" FontSize="14" LineHeight="22"/>
                                        <TextBlock Text="How this was gathered" Foreground="{StaticResource TealSoftBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                        <TextBlock Text="{Binding Method}" Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="20"/>
                                        <TextBlock Text="What this does not mean" Foreground="{StaticResource TealSoftBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                        <TextBlock Text="{Binding Caveat}" Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="20"/>
                                        <Expander Visibility="{Binding FixVisibility}" Margin="0,16,0,0" IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock Text="How to fix this" Foreground="{StaticResource TealSoftBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            </Expander.Header>
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="{Binding FixTitle}" FontFamily="Georgia" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding FixBody}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" LineHeight="22"/>
                                                <ItemsControl ItemsSource="{Binding FixLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#0C1220" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" BorderBrush="#243247" BorderThickness="1">
                                                                <DockPanel LastChildFill="True">
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Copy" Padding="12,6" MinHeight="32" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Top" Tag="{Binding Copy}" Click="CopyLine_Click" Visibility="{Binding CopyVisibility}"/>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Text}" FontSize="13" LineHeight="20"/>
                                                                        <TextBlock Text="{Binding Copy}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TealSoftBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding CopyVisibility}"/>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="LimitsBox" Visibility="Collapsed" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="28" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Limits of this check" FontSize="18" FontWeight="SemiBold" FontFamily="Georgia"/>
                        <ItemsControl x:Name="LimitsList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" LineHeight="22"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
