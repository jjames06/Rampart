<Window x:Class="SiteCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site Check  ·  Operation Locked In"
        Height="820" Width="920" MinHeight="640" MinWidth="760"
        Background="{StaticResource NavyBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,40">
            <TextBlock Text="OPERATION LOCKED IN" Foreground="{StaticResource TealBrush}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Text="Site Check" FontSize="32" FontWeight="SemiBold" FontFamily="Georgia" Margin="0,6,0,0"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="15" LineHeight="22" Margin="0,10,0,0"
                       Text="A short, read-only look at a public hostname you operate. The program reports HTTPS, certificate days, a few security headers, and whether SPF exists. It does not crawl the site, follow redirects, or contact private networks."/>

            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,22,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Hostname" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="HostBox" FontSize="16" Padding="10,8" Background="#0B1220" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource LineBrush}" CaretBrush="{StaticResource TealBrush}"
                             Text="www.example.com"/>
                    <CheckBox x:Name="PermissionBox" Margin="0,14,0,0" Foreground="{StaticResource TextBrush}" FontSize="14">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                            I operate this hostname, or I have written permission to check it. I understand that checking a system without authorization can be a criminal offence in Canada.
                        </TextBlock>
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Content="Check this hostname" Click="Run_Click"/>
                        <Button x:Name="CopyButton" Style="{StaticResource GhostButton}" Content="Copy report" Margin="10,0,0,0" Click="Copy_Click" IsEnabled="False"/>
                        <Button x:Name="SaveButton" Style="{StaticResource GhostButton}" Content="Save report" Margin="10,0,0,0" Click="Save_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" Text="No check has been run yet."/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="FindingsList" Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding State}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{Binding StateBrush}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Observation}" Margin="0,8,0,0" FontSize="14" LineHeight="22"/>
                                <TextBlock Text="How this was gathered" Foreground="{StaticResource TealBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <TextBlock Text="{Binding Method}" Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="20"/>
                                <TextBlock Text="What this does not mean" Foreground="{StaticResource TealBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                <TextBlock Text="{Binding Caveat}" Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="LimitsBox" Visibility="Collapsed" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Limits" FontSize="18" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="LimitsList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" LineHeight="20"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
