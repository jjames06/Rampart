<!--
  CODEMAP FILE: src/SiteCheck.Maui/MainPage.xaml
  Product: Rampart (oli-site-check) — read-only public-surface hostname checker, public pin 1.9.0
  Role: Phone layout: consent, hostname, findings, how-to, share.
  Called by: App.xaml.cs.
  Calls: MainPage.xaml.cs.
  Invariants: Same FindingGuide rules as desktop. Ready-to-submit; not a live store listing until SUBMIT.md is done.
  Sisters: Bastion (bastion-hardening) hardens the local Windows PC. bastion-web is the public storefront and hosts /rampart plus the GitHub asset redirect. oli-web-kits client brochures should already 404 the probe paths this checker GETs.
  Map: docs/CODEMAP.md — read that file first for the run/load graph.
-->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteCheck.Maui.MainPage"
             Title="Rampart"
             BackgroundColor="#070B14">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="OPERATION LOCKED IN" TextColor="#5EEAD4" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
            <Label Text="Rampart" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
            <Label Text="Read-only public-surface assessment of a hostname you operate. Tick both boxes. Each finding includes how it was gathered, what it does not mean, and, when work is needed, How to fix this with copyable lines. The check is the same Core as Windows: HTTPS, headers, sign-in paths, private-file paths, www and apex, mail DNS, the local CVE catalogue, and advertised enterprise portals. Reports stay on this phone. No exploit traffic."
                   TextColor="#C5D0DE" LineBreakMode="WordWrap"/>

            <Label Text="Hostname" FontAttributes="Bold"/>
            <Entry x:Name="HostBox" Placeholder="www.example.com" TextColor="#F8FAFC" BackgroundColor="#0C1220"/>

            <Label Text="Scope" FontAttributes="Bold" Margin="0,8,0,0"/>
            <RadioButton x:Name="StandardScope" GroupName="RampartScope" IsChecked="True" Content="Standard public-surface check" TextColor="#F8FAFC"/>
            <RadioButton x:Name="AssessmentScope" GroupName="RampartScope" Content="Authorized public-surface assessment (RFC files and extra DNS)" TextColor="#F8FAFC"/>

            <CheckBox x:Name="PermissionBox" Color="#2DD4BF" CheckedChanged="Consent_Changed"/>
            <Label x:Name="PermissionLabel" LineBreakMode="WordWrap"/>

            <CheckBox x:Name="LawBox" Color="#2DD4BF" CheckedChanged="Consent_Changed"/>
            <Label x:Name="LawLabel" LineBreakMode="WordWrap"/>

            <HorizontalStackLayout Spacing="8">
                <Button x:Name="RunButton" Text="Check this hostname" Clicked="Run_Clicked" IsEnabled="False"/>
                <Button x:Name="CancelButton" Text="Stop this check" Clicked="Cancel_Clicked" IsVisible="False" BackgroundColor="Transparent" TextColor="#5EEAD4" BorderColor="#2DD4BF" BorderWidth="1"/>
                <Button x:Name="SaveButton" Text="Share report" Clicked="Save_Clicked" IsEnabled="False" BackgroundColor="Transparent" TextColor="#5EEAD4" BorderColor="#2DD4BF" BorderWidth="1"/>
            </HorizontalStackLayout>

            <Label x:Name="StatusText" TextColor="#5EEAD4" LineBreakMode="WordWrap"
                   Text="Enter a public hostname, tick both permission boxes, then check."/>

            <Label x:Name="SummaryText" IsVisible="False" TextColor="#C5D0DE" LineBreakMode="WordWrap"/>

            <VerticalStackLayout x:Name="FindingsHost" Spacing="10"/>

            <Label Text="Desktop copies are GNU GPLv3. This store binary is additionally licensed under Apache License 2.0 so it can sit on the App Store and Google Play. There is no warranty. Privacy: operationlockedin.com/privacy"
                   TextColor="#C5D0DE" FontSize="12" LineBreakMode="WordWrap" Margin="0,12,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
