<!--
  CODEMAP FILE: src/SiteCheck.Maui/App.xaml
  Product: Rampart (oli-site-check) — read-only public-surface hostname checker, public pin 1.9.0
  Role: MAUI Application XAML. Navigation chrome only.
  Called by: App.xaml.cs.
  Calls: MainPage.xaml.
  Invariants: Store binaries use LICENSE.MOBILE (Apache-2.0 additional). Desktop remains GPLv3.
  Sisters: Bastion (bastion-hardening) hardens the local Windows PC. bastion-web is the public storefront and hosts /rampart plus the GitHub asset redirect. oli-web-kits client brochures should already 404 the probe paths this checker GETs.
  Map: docs/CODEMAP.md — read that file first for the run/load graph.
-->

<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteCheck.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Navy">#070B14</Color>
            <Color x:Key="Card">#162033</Color>
            <Color x:Key="Teal">#2DD4BF</Color>
            <Color x:Key="Text">#F8FAFC</Color>
            <Color x:Key="Muted">#C5D0DE</Color>
            <Style TargetType="Page">
                <Setter Property="BackgroundColor" Value="{StaticResource Navy}"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Text}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Teal}"/>
                <Setter Property="TextColor" Value="{StaticResource Navy}"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Padding" Value="18,12"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
