<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net8.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SiteCheck.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Rampart</ApplicationTitle>
    <ApplicationId>com.operationlockedin.rampart</ApplicationId>
    <ApplicationDisplayVersion>1.9.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <Version>1.9.0</Version>
    <FileVersion>1.9.0.0</FileVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <Authors>Jesse Mosier-Bowers</Authors>
    <Company>Operation Locked In</Company>
    <Product>Rampart</Product>
    <Copyright>Copyright 2026 Jesse Mosier-Bowers, operating as Operation Locked In</Copyright>
    <Description>Read-only public-surface assessment of a hostname you operate.</Description>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#070B14" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiteCheck.Core\SiteCheck.Core.csproj" />
  </ItemGroup>

</Project>
